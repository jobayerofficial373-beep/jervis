[app]
title = JERVIS AI
package.name = jervis
package.domain = org.jervis
source.dir = .
source.include_exts = py,png,jpg,kv
version = 1.0
requirements = python3,kivy
orientation = portrait
fullscreen = 0
android.permissions = INTERNET,RECORD_AUDIO
android.archs = arm64-v8a
android.minapi = 23
android.accept_sdk_license = True

[buildozer]
log_level = 2
warn_on_root = 0
